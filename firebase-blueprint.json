{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Synced player profile, currency, unlocked wardrobe items, equipped skins, colors, and game settings for 1450 Party.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Authentication user UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Unique display nickname in game arenas",
          "maxLength": 32
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Google account email",
          "maxLength": 160
        },
        "photoURL": {
          "type": "string",
          "description": "Google account avatar URL",
          "maxLength": 512
        },
        "coins": {
          "type": "number",
          "description": "Player coin balance"
        },
        "matches": {
          "type": "number",
          "description": "Total completed matches count"
        },
        "owned": {
          "type": "array",
          "description": "List of owned shop item IDs"
        },
        "equipped": {
          "type": "object",
          "description": "Equipped outfit, hat, and accessory IDs per player slot (0-3)"
        },
        "colors": {
          "type": "array",
          "description": "4 hex color strings for P1-P4"
        },
        "muted": {
          "type": "boolean",
          "description": "SFX mute state"
        },
        "volume": {
          "type": "number",
          "description": "SFX volume (0 to 1)"
        },
        "musicVolume": {
          "type": "number",
          "description": "Menu music volume (0 to 1)"
        },
        "musicMuted": {
          "type": "boolean",
          "description": "Menu music mute state"
        },
        "battleVolume": {
          "type": "number",
          "description": "Battle music volume (0 to 1)"
        },
        "battleMuted": {
          "type": "boolean",
          "description": "Battle music mute state"
        },
        "shakeEnabled": {
          "type": "boolean",
          "description": "Screen shake enabled flag"
        },
        "joystickSize": {
          "type": "string",
          "enum": ["small", "normal", "large"],
          "description": "Touchscreen joystick size preference"
        },
        "onlineSplitButtons": {
          "type": "boolean",
          "description": "Whether separate Attack and Jump buttons are enabled in online mode"
        },
        "onlineControlsSwapped": {
          "type": "boolean",
          "description": "Whether joystick and action buttons are swapped left/right in online mode"
        },
        "isOnline": {
          "type": "boolean",
          "description": "Live active session presence flag"
        },
        "lastSeenAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the user's last active heartbeat"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp"
        }
      },
      "required": [
        "uid",
        "name",
        "coins",
        "matches",
        "owned",
        "equipped",
        "colors",
        "muted",
        "volume",
        "musicVolume",
        "musicMuted",
        "battleVolume",
        "battleMuted",
        "shakeEnabled",
        "joystickSize",
        "onlineSplitButtons",
        "onlineControlsSwapped",
        "isOnline",
        "lastSeenAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "UsernameClaim": {
      "title": "UsernameClaim",
      "description": "Unique global player nickname reservation entry keyed by normalized hex ID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Owner Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Reserved player display name",
          "minLength": 1,
          "maxLength": 32
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server reservation timestamp"
        }
      },
      "required": ["uid", "name", "updatedAt"]
    },
    "OnlineRoom": {
      "title": "OnlineRoom",
      "description": "Active multiplayer room entry for discovery and WebRTC host matching.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "name": { "type": "string", "minLength": 1, "maxLength": 24 },
        "hostUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "hostName": { "type": "string", "minLength": 1, "maxLength": 32 },
        "locked": { "type": "boolean" },
        "playerCount": { "type": "number" },
        "status": { "type": "string", "enum": ["lobby", "playing"] },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "name", "hostUid", "hostName", "locked", "playerCount", "status", "updatedAt"]
    },
    "RoomSignal": {
      "title": "RoomSignal",
      "description": "WebRTC SDP offer/answer and ICE candidate exchange document for a guest joining a room.",
      "type": "object",
      "properties": {
        "guestUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "guestName": { "type": "string", "maxLength": 32 },
        "password": { "type": "string", "maxLength": 32 },
        "offer": { "type": "string" },
        "answer": { "type": "string" },
        "guestCandidates": { "type": "array" },
        "hostCandidates": { "type": "array" },
        "status": { "type": "string", "enum": ["pending", "answered", "rejected"] },
        "updatedAt": { "type": "number" }
      },
      "required": ["guestUid", "guestName", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Private per-user game profile, shop inventory, and settings document."
    },
    "/usernames/{nameKey}": {
      "schema": {
        "$ref": "#/entities/UsernameClaim"
      },
      "description": "Global unique nickname registry preventing duplicate player names."
    },
    "/rooms/{roomId}": {
      "schema": {
        "$ref": "#/entities/OnlineRoom"
      },
      "description": "Active multiplayer rooms for real-time room discovery."
    },
    "/rooms/{roomId}/signals/{signalId}": {
      "schema": {
        "$ref": "#/entities/RoomSignal"
      },
      "description": "Per-guest WebRTC signaling exchange inside an online room."
    }
  }
}
